{
  "units": [
    {
      "id": "u1",
      "title": "Unit 1 · HTML Fundamentals",
      "desc": "How the web works, and how to write correct, meaningful HTML5: structure, text, lists, links, images, SVG, media, SEO and good habits."
    },
    {
      "id": "u2",
      "title": "Unit 2 · Semantic HTML and Forms",
      "desc": "Pages with meaning: semantic layout, accessibility, forms and every input type, validation, tables, the WCAG standards and content that adapts to any screen."
    },
    {
      "id": "u3",
      "title": "Unit 3 · Cascading Style Sheets",
      "desc": "Making a page look the way you want: colours, fonts, spacing, layout with Flexbox and Grid, states, variables, responsive design and motion. Written for someone who has never styled anything before."
    },
    {
      "id": "ap",
      "title": "Appendix &middot; Reference shelf"
    }

{
  "units": [
    {
      "id": "u1",
      "title": "Unit 1 · HTML Fundamentals",
      "desc": "How the web works, and how to write correct, meaningful HTML5: structure, text, lists, links, images, SVG, media, SEO and good habits."
    },
    {
      "id": "u2",
      "title": "Unit 2 · Semantic HTML and Forms",
      "desc": "Pages with meaning: semantic layout, accessibility, forms and every input type, validation, tables, the WCAG standards and content that adapts to any screen."
    },
    {
      "id": "u3",
      "title": "Unit 3 · Cascading Style Sheets",
      "desc": "Making a page look the way you want: colours, fonts, spacing, layout with Flexbox and Grid, states, variables, responsive design and motion. Written for someone who has never styled anything before."
    },
    {
      "id": "u4",
      "title": "Unit 4 · JavaScript Fundamentals",
      "desc": "Your first programming language: values, variables, operators, strings, numbers, decisions, functions, scope, arrays and objects. Written for someone who has never written a program before."
    },
    {
      "id": "u5",
      "title": "Unit 5 · Interactive Web Development",
      "desc": "Making pages respond: loops, callbacks and higher-order functions, the DOM, events, generated content, accessible scripting, validation, regular expressions, dates, media, storage, fetch, location and drag-and-drop."
    },
    {
      "id": "u6",
      "title": "Unit 6 · Web Application Development and Deployment",
      "desc": "From working code to a live website: debugging, DevTools, error handling, interface and application design, code organisation, performance, Git and GitHub, GitHub Pages, best practices and working with GitHub Copilot."
    },
    {
      "id": "ap",
      "title": "Appendix &middot; Reference shelf"
    }
  ],
